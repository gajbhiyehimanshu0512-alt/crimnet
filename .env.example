# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cna_password123

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://cna_user:cna_pass@localhost:5432/criminal_network

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ChromaDB Vector Store ──────────────────────────────────────────────────────
CHROMA_URL=http://localhost:8001

# ── Ollama Local LLM ──────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── (Optional) External LLM — leave blank to use Ollama ──────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-in-production-to-a-random-string
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
