# ═══════════════════════════════════════════════════════════════════
# CrimNet — Production Environment Variables
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_STRING

# ── Neo4j Aura (free cloud graph DB — https://neo4j.com/cloud/aura-free) ─────
NEO4J_URL=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_AURA_PASSWORD

# ── PostgreSQL (Railway managed DB) ──────────────────────────────────────────
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# ── Redis (Upstash — https://upstash.com) ────────────────────────────────────
REDIS_URL=rediss://default:TOKEN@HOST:PORT

# ── ChromaDB — disable in cloud (no persistent server) ───────────────────────
USE_CHROMA=false
CHROMA_URL=http://localhost:8001

# ── Groq AI (free — https://console.groq.com) ────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_GROQ_KEY
GROQ_MODEL=llama3-70b-8192

# ── Optional: OpenAI / Gemini (leave blank to use Groq) ──────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Ollama (local only, not used in cloud) ────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── CORS: Comma-separated list of allowed frontend origins ───────────────────
CORS_ORIGINS=https://YOUR-APP.vercel.app,http://localhost:3000

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
